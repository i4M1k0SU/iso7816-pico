# clang-tidy configuration for the host-buildable sources (src/core, include, examples/demo, tests), checked by the CI
# job `clang-tidy` against the compile_commands.json of the host-test build (see docs/tools.md).
#
# Enabled: bugprone-*, clang-analyzer-*, misc-*, performance-*, portability-* and a few cheap readability checks that
# catch real mistakes rather than enforce a style.  Disabled, and why:
#   bugprone-easily-swappable-parameters         a byte-oriented protocol API has many (uint8_t, uint8_t) and
#                                                (const uint8_t *, size_t) parameter pairs; changing them is not
#                                                worth it, and the tests cover the call sites
#   bugprone-signed-bitwise                      flags every bitwise operation on uint8_t (integer promotion to int);
#                                                that is the normal way to handle bytes in C
#   bugprone-implicit-widening-of-multiplication-result
#                                                only small compile-time sizes (sector counts, record slots) are
#                                                multiplied; none can overflow int
#   bugprone-not-null-terminated-result          memcpy into byte buffers (APDU data), not strings
#   misc-include-cleaner                         wants one include per symbol (no umbrella headers such as test.h);
#                                                noise for this code base
#   misc-use-internal-linkage                    flags the symbols the framework or the Pico SDK stubs resolve at link
#                                                time (demo_card_profile, get_rand_32)
#   portability-avoid-pragma-once                every header uses #pragma once on purpose
#   readability-redundant-nested-if              PPS parsing keeps "is this byte present" and "read it" apart
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                                wants the C11 Annex K functions (memcpy_s, ...), which neither newlib
#                                                nor glibc provide; every memcpy / memset is bounded by its caller
#   clang-analyzer-optin.performance.Padding     fs_file_t keeps the documented field order; the file tables are const
#                                                and live in flash
# Analyzer false positives are suppressed in place with NOLINTNEXTLINE and a comment saying why.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-avoid-const-params-in-decls,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-non-const-parameter,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-not-null-terminated-result,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -portability-avoid-pragma-once,
  -readability-redundant-nested-if,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.performance.Padding
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src/core|tests|examples/demo)/.*'
