# Writes iso7816_pico_build.h with the commit of the framework and of the application.  Run as a script at every build
# (the iso7816_pico_build_info target in the top CMakeLists.txt), so the hash follows HEAD without a re-configure:
#
#   cmake -DGIT_EXECUTABLE=<git or empty> -DFRAMEWORK_DIR=<dir> -DAPP_DIR=<dir> -DOUTPUT=<file> -P build_info.cmake
#
# A commit is the first 7 characters of HEAD, with "-dirty" when tracked files differ from HEAD (untracked files do not
# count, as with git describe --dirty), or "unknown" without git or a repository.  The framework's commit is taken only
# when FRAMEWORK_DIR is the top of a work tree (its own clone or a submodule): a framework unpacked from a tarball
# inside the application's repository must not report the application's commit.  The file is rewritten only when its
# content changes, so an unchanged commit rebuilds nothing.
cmake_minimum_required(VERSION 3.13)

function(git_commit dir require_toplevel out)
    set(${out} "unknown" PARENT_SCOPE)
    if(NOT GIT_EXECUTABLE)
        return()
    endif()
    if(require_toplevel)
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${dir} rev-parse --show-toplevel
                RESULT_VARIABLE rc OUTPUT_VARIABLE top ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT rc EQUAL 0)
            return()
        endif()
        get_filename_component(top "${top}" REALPATH)
        get_filename_component(want "${dir}" REALPATH)
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${top}" top)
            string(TOLOWER "${want}" want)
        endif()
        if(NOT top STREQUAL want)
            return()
        endif()
    endif()
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${dir} rev-parse --short=7 HEAD
            RESULT_VARIABLE rc OUTPUT_VARIABLE hash ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT rc EQUAL 0 OR hash STREQUAL "")
        return()
    endif()
    string(SUBSTRING "${hash}" 0 7 hash)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${dir} status --porcelain --untracked-files=no
            RESULT_VARIABLE rc OUTPUT_VARIABLE changes ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND NOT changes STREQUAL "")
        string(APPEND hash "-dirty")
    endif()
    set(${out} "${hash}" PARENT_SCOPE)
endfunction()

git_commit("${FRAMEWORK_DIR}" TRUE framework)
git_commit("${APP_DIR}" FALSE app)

set(content "// Generated by cmake/build_info.cmake at build time.  Do not edit.
#pragma once
#define ISO7816_PICO_COMMIT \"${framework}\"
#define ISO7816_PICO_APP_COMMIT \"${app}\"
")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
