;
; ISO 7816-3 card-side character I/O for RP2040 PIO.
;
; Both state machines derive all timing from the *external* card clock (contact C3) by counting its edges with `wait
; gpio`, so they work for any clock frequency the reader chooses and need no measurement of it.
;
;   1 ETU = F/D clock cycles (372 with the default F=372, D=1; other values
;   after a PPS exchange).
;
; `wait gpio` takes an absolute GPIO number, so a clock pin is baked into the instructions below.  phy.c rewrites that
; index in instruction memory at start-up to ISO7816_PIN_CLK from config.h, so this value is only a placeholder.
;
.define PUBLIC ISO7816_CLK_GPIO 1

; ---------------------------------------------------------------------------
; RX: reader -> card
;
;   IN pin 0 = I/O (contact C7)
;   OSR      = (ETU - 1) in clock cycles, loaded once by the CPU and never
;              consumed.  Each delay block below counts (ETU) clock *edges*
;              (= ETU/2 clock cycles = half an ETU), which keeps odd ETU
;              lengths such as 93 (F=372, D=4) exact.
;   IN shift = right, no autopush.
;
; Waits for the falling edge of a start bit, then samples the line in the middle of each of the following 9 bits (8 data
; bits + parity), i.e. at 1.5, 2.5 ... 9.5 ETU after the start edge.
;
; Pushes one word per character: bit0..7 = line states in arrival order, bit8 = parity bit line state.  Convention
; (direct/inverse) is applied by the CPU.
; ---------------------------------------------------------------------------
.program iso7816_rx
.wrap_target
    wait 1 pin 0                      ; line idle (high)
    wait 0 pin 0                      ; start bit falling edge
    set y, 8                          ; 9 bits to sample
    mov x, osr                        ; -- 0.5 ETU --
d0a:
    wait 0 gpio ISO7816_CLK_GPIO
    jmp x-- d0b
    jmp bitloop
d0b:
    wait 1 gpio ISO7816_CLK_GPIO
    jmp x-- d0a
bitloop:
    mov x, osr                        ; -- 0.5 ETU --
d1a:
    wait 0 gpio ISO7816_CLK_GPIO
    jmp x-- d1b
    jmp half2
d1b:
    wait 1 gpio ISO7816_CLK_GPIO
    jmp x-- d1a
half2:
    mov x, osr                        ; -- 0.5 ETU --
d2a:
    wait 0 gpio ISO7816_CLK_GPIO
    jmp x-- d2b
    jmp sample
d2b:
    wait 1 gpio ISO7816_CLK_GPIO
    jmp x-- d2a
sample:
    in pins, 1                        ; sample at the centre of the bit
    jmp y-- bitloop
    in null, 23                       ; right-align the 9 bits
    push block
.wrap

; ---------------------------------------------------------------------------
; TX: card -> reader
;
;   OUT pin 0 = I/O, driven as open drain: the GPIO output value is fixed at 0
;               and `out pindirs` switches between "drive low" (1) and
;               "release" (0).
;   Y         = (ETU - 1) in clock cycles, loaded once by the CPU.
;   OUT shift = right, autopull; the pull threshold is the frame length in bits
;               (phy.c sets it: 12 for a character with no extra guard time).
;
; The program is a plain bit-stream shifter: one bit per ETU, straight from the FIFO.  When the FIFO runs dry the `out`
; stalls with the line left in the state of the last bit, which for a character is a released (idle) line. The CPU
; builds complete frames (start, 8 data, parity, guard bits).
; ---------------------------------------------------------------------------
.program iso7816_tx
.wrap_target
    out pindirs, 1
    mov x, y                          ; -- 1 ETU --
delay:
    wait 0 gpio ISO7816_CLK_GPIO
    wait 1 gpio ISO7816_CLK_GPIO
    jmp x-- delay
.wrap

; ---------------------------------------------------------------------------
; Test clock: ~3.9 MHz square wave (32 sysclk cycles per period at 125 MHz) on the SET pin, used by the loopback
; self-test instead of the reader's CLK. Lives in the other PIO block (pio1), the card programs fill pio0.
; ---------------------------------------------------------------------------
.program clkgen
.wrap_target
    set pins, 1 [15]
    set pins, 0 [15]
.wrap
